---
import '../styles/global.css';
import Navbar from '@/components/ui/Navbar.astro';
import Footer from '@/components/ui/Footer.astro';
const currentPath = Astro.url.pathname;
const isContact = currentPath === '/contact';
const pageBg = isContact ? 'bg-orange-brand' : '';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/logoMR.png" />
		<meta name="generator" content={Astro.generator} />
		<title>MiguelRequenaR</title>
	</head>
	<body class={`flex flex-col min-h-screen m-0 w-full ${pageBg}`}>
		<Navbar isContact={isContact} />
		<slot />
		<Footer isContact={isContact} />
		<script src="../scripts/lenis.js"></script>
	</body>
</html>

<style>
	html {
		margin: 0;
		width: 100%;
	}
</style>
