---
import { ClientRouter } from "astro:transitions"
import "../styles/global.css";
import Navbar from "@/components/ui/Navbar.astro";
import Footer from "@/components/ui/Footer.astro";
import { SITE } from "@/config/seo";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: "website" | "article";
  keywords?: string[];
}

const {
  title = SITE.title,
  description = SITE.description,
  image = SITE.ogImage,
  canonicalURL = SITE.url,
  type = "website",
  keywords = SITE.keywords,
} = Astro.props;

const fullTitle = title === SITE.title ? SITE.title : `${title} | ${SITE.title}`;
const url = new URL(canonicalURL, SITE.url);
const imageUrl = image.startsWith("http") ? image : new URL(image, SITE.url).href;

const currentPath = Astro.url.pathname;
const isContact = currentPath === "/contact" || currentPath === "/contact/";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: SITE.author,
      url: SITE.url,
      image: imageUrl,
      sameAs: SITE.sameAs,
      description: SITE.description,
    },
    {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
      publisher: {
        "@type": "Person",
        name: SITE.author,
      },
    },
  ],
};
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<ClientRouter />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content={SITE.author} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords.join(", ")} />

		<title>{fullTitle}</title>
		<link rel="canonical" href={url.href} />

		<link rel="icon" type="image/png" href="/logoMR.png" />
		<link rel="preload" href="/fonts/hasta-grotesk.ttf" as="font" type="font/ttf" crossorigin />

		<meta property="og:type" content={type} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:url" content={url.href} />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:locale" content={SITE.locale} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:site" content={SITE.twitterHandle} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<script is:inline>
			document.addEventListener('astro:before-swap', (e) => {
				const splash = e.newDocument?.getElementById('splash-screen');
				if (splash) splash.remove();
			});
		</script>
	</head>
	<body
		class="flex flex-col min-h-screen m-0 w-full"
		style={isContact ? "background-color: #f46c38;" : ""}
	>
		<Navbar isContact={isContact} />
		<slot />
		<Footer isContact={isContact} />
		<script src="../scripts/lenis.js"></script>
	</body>
</html>

<style>
	html {
		margin: 0;
		width: 100%;
	}
</style>
