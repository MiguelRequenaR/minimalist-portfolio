---

<div id="splash-screen">
  <span class="text-white text-4xl font-bold leading-relaxed">
    MiguelRequenaR
  </span>
</div>

<style>
  #splash-screen {
    display: var(--splash-hidden, flex);
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #f46c38;
    align-items: center;
    justify-content: center;
  };
</style>

<script>
  import { gsap } from "gsap";

  const splash = document.getElementById("splash-screen");
  const text = splash?.querySelector("span") ?? null;

  const tl = gsap.timeline({ delay: 1 });

  tl.to(splash, {
    y: "-100%",
    duration: 1.2,
    ease: "power3.inOut",
    onComplete: () => {
      splash?.remove();
    }
  })

  tl.to(text, {
    scale: 3,
    duration: 1.2,
    ease: "power3.inOut",
  }, 0);

</script>
