---

<div id="splash-screen">
  <span class="text-white text-4xl font-bold leading-relaxed">
    MiguelRequenaR
  </span>
</div>

<style>
  #splash-screen {
    display: var(--splash-hidden, flex);
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #f46c38;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  import { gsap } from "gsap";

  const splash = document.getElementById("splash-screen");
  const text = splash?.querySelector("span") ?? null;

  const splashShown = sessionStorage.getItem("splashShown");

  if (splashShown) {
    splash?.remove();
  } else {
    sessionStorage.setItem("splashShown", "true");

    gsap.set(text, { scale: 0.5, opacity: 0 });

    const tl = gsap.timeline({ delay: 0.3 });

    tl.to(text, {
      scale: 1,
      opacity: 1,
      duration: 0.7,
      ease: "back.out(1.7)",
    });

    tl.to(splash, {
      y: "-100%",
      duration: 1.2,
      ease: "power3.inOut",
      onComplete: () => {
        splash?.remove();
      }
    }, "+=0.8");

    tl.to(text, {
      scale: 3,
      duration: 1.2,
      ease: "power3.inOut",
    }, "<");
  }
</script>
